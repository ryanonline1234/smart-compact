  "targets": {
    "hero-section": "[data-scene='hero']",
    "hero-claim": "[data-motion='hero-claim']",
    "stage-section": "[data-scene='stage']",
    "stage-pin": {
      "selector": "[data-pin='stage']",
      "vars": [
        "--stage-progress"
      ]
    },
    "slab-conversation": {
      "selector": "[data-motion='slab-conversation']",
      "vars": [
        "--tokens"
      ]
    },
