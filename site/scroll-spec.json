  "scenes": [
    {
      "id": "hero",
      "label": "Hero: one claim, one install line",
      "selector": "[data-scene='hero']",
      "rangePx": {
        "fromPx": 0,
        "toPx": 900
      },
      "expectations": [
        {
          "id": "hero-claim-painted",
          "target": "hero-claim",
          "property": "effectiveOpacity",
          "tolerance": 0.03,
          "mustChange": false,
          "keys": [
            {
              "localProgress": 0,
              "value": 1,
              "label": "painted at the top, no load gate"
            }
          ],
          "note": "Content is never gated behind motion: the claim is visible on first paint."
        }
      ]
    },
    {
      "id": "stage",
      "label": "Sticky stage: the context window, exploded",
      "selector": "[data-scene='stage']",
      "rangePx": {
        "fromPx": 900,
        "toPx": 4500
      },
      "pin": {
        "pins": true,
        "selector": "[data-pin='stage']",
        "driftTolerancePx": 2,
        "expectedTopPx": 0
      },
      "expectations": [
        {
          "id": "stage-pin-holds",
          "target": "stage-pin",
          "property": "rect.top",
          "tolerance": 2,
          "mustChange": false,
          "keys": [
            {
              "localProgress": 0.05,
              "value": 0,
              "label": "just pinned"
            },
            {
              "localProgress": 0.5,
              "value": 0,
              "label": "mid"
            },
            {
              "localProgress": 0.95,
              "value": 0,
              "label": "about to release"
            }
          ],
          "note": "position: sticky on a 100vh child of a 500vh section; constancy is the assertion."
        },
        {
          "id": "stage-progress",
          "target": "stage-pin",
          "property": "cssVar",
          "cssVarName": "--stage-progress",
          "tolerance": 0.02,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0,
              "value": 0
            },
            {
              "localProgress": 0.5,
              "value": 0.5
            },
            {
              "localProgress": 1,
              "value": 1
            }
          ],
          "easeRef": "linear by construction: the raw stage-local scroll fraction every scrubbed value reads",
          "note": "Read this line first: if s is wrong, every failure below is a symptom."
        },
        {
          "id": "conversation-fills-then-compacts",
          "target": "slab-conversation",
          "property": "cssVar",
          "cssVarName": "--tokens",
          "tolerance": 600,
          "keys": [
            {
              "localProgress": 0,
              "value": 2000,
              "label": "empty conversation"
            },
            {
              "localProgress": 0.1,
              "value": 21000,
              "label": "half full"
            },
            {
              "localProgress": 0.2,
              "value": 40000,
              "label": "full: 91k with the 51k fixed block"
            },
            {
              "localProgress": 0.45,
              "value": 40000,
              "label": "held through SAVE"
            },
            {
              "localProgress": 0.6,
              "value": 34000,
              "label": "compacting"
            },
            {
              "localProgress": 0.7,
              "value": 28000,
              "label": "compacted: engine count"
            },
            {
              "localProgress": 1,
              "value": 28000,
              "label": "held"
            }
          ],
          "easeRef": "none: linear scrub on [0,.2] and [.5,.7]; easing a scrub reads as lag against the scrollbar"
        },
        {
          "id": "manifest-explodes-then-returns",
          "target": "slab-state",
          "property": "cssVar",
          "cssVarName": "--pos",
          "tolerance": 0.04,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0.2,
              "value": 0,
              "label": "inside the conversation"
            },
            {
              "localProgress": 0.35,
              "value": 0.5
            },
            {
              "localProgress": 0.45,
              "value": 1,
              "label": "exploded out"
            },
            {
              "localProgress": 0.75,
              "value": 1,
              "label": "held outside through COMPACT"
            },
            {
              "localProgress": 0.85,
              "value": 1.5
            },
            {
              "localProgress": 0.95,
              "value": 2,
              "label": "back on the stack: rehydrated"
            }
          ],
          "easeRef": "none: linear scrub on [.25,.45] and [.75,.95]"
        },
        {
          "id": "checkpoint-comes-back-at-compaction",
          "target": "slab-checkpoint",
          "property": "cssVar",
          "cssVarName": "--pos",
          "tolerance": 0.04,
          "monotonic": "increasing",
          "keys": [
            {
              "localProgress": 0.25,
              "value": 0
            },
            {
              "localProgress": 0.45,
              "value": 1,
              "label": "exploded out"
            },
            {
              "localProgress": 0.6,
              "value": 1
            },
            {
              "localProgress": 0.7,
              "value": 2,
              "label": "re-attached by compaction"
            }
          ],
          "easeRef": "none: linear scrub on [.25,.45] and [.6,.7]"
        },
        {
          "id": "chapter-2-active-only-in-save",
          "target": "chapter-2",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.12,
              "value": 0.28,
              "label": "dimmed"
            },
            {
              "localProgress": 0.37,
              "value": 1,
              "label": "active"
            },
            {
              "localProgress": 0.62,
              "value": 0.28,
              "label": "dimmed again"
            }
          ],
          "easeRef": "250ms cubic-out per exploded-blueprint-mono entry (out(3)); time-based, measured after settle"
        },
        {
          "id": "chapter-4-active-in-rehydrate",
          "target": "chapter-4",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.62,
              "value": 0.28
            },
            {
              "localProgress": 0.87,
              "value": 1
            }
          ]
        },
        {
          "id": "conversation-label-reveals",
          "target": "label-conversation",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.02,
              "value": 0,
              "label": "hidden before the slab exists"
            },
            {
              "localProgress": 0.12,
              "value": 1,
              "label": "revealed"
            }
          ]
        },
        {
          "id": "rehydrate-label-reveals-last",
          "target": "label-rehydrate",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.7,
              "value": 0
            },
            {
              "localProgress": 0.97,
              "value": 1
            }
          ]
        },
        {
          "id": "chapter-1-active-only-in-fill",
          "target": "chapter-1",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.1,
              "value": 1,
              "label": "active"
            },
            {
              "localProgress": 0.37,
              "value": 0.28,
              "label": "dimmed"
            }
          ]
        },
        {
          "id": "chapter-3-active-only-in-compact",
          "target": "chapter-3",
          "property": "opacity",
          "tolerance": 0.03,
          "keys": [
            {
              "localProgress": 0.37,
              "value": 0.28
            },
            {
              "localProgress": 0.62,
              "value": 1,
              "label": "active"
            },
            {
              "localProgress": 0.87,
              "value": 0.28
            }
          ]
        }
      ]
    },
    {
      "id": "evidence",
      "label": "Evidence and install: static, never gated",
      "selector": "[data-scene='evidence']",
      "rangePx": {
        "fromPx": 4500,
        "toPx": 7198
      },
      "expectations": [
        {
          "id": "ledger-painted",
          "target": "ledger-table",
          "property": "effectiveOpacity",
          "tolerance": 0.03,
          "mustChange": false,
          "keys": [
            {
              "localProgress": 0.3,
              "value": 1,
              "label": "the calibration ledger is plain, readable content"
            }
          ],
          "note": "No scroll reveal on evidence: the numbers are the point and must read without motion."
        },
        {
          "id": "install-painted",
          "target": "install-command",
          "property": "effectiveOpacity",
          "tolerance": 0.03,
          "mustChange": false,
          "keys": [
            {
              "localProgress": 1,
              "value": 1,
              "label": "install command visible at the bottom"
            }
          ]
        }
      ]
    }
  ]
